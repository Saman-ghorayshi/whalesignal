# WhaleSignal — environment variables.
# Copy to .env (gitignored) and fill in. Everything marked [optional] has a
# working keyless fallback; the [recommended] three unlock full quality.

# ── Cloudflare (deploys + D1/KV management) ──────────────────────────
# API token with Workers/D1/KV edit perms: dash.cloudflare.com → My Profile → API Tokens
CF_ID=
# ── Telegram ─────────────────────────────────────────────────────────
# Bot token from @BotFather (the bot's own token — also set as BOT_TOKEN
# secret on the workers via `wrangler secret put`)
TG_TOKEN=
# ── [recommended] CoinGecko demo keys ────────────────────────────────
# coingecko.com/en/api — free; 2-3 keys from separate accounts rotate
# automatically (comma-separated) to spread the monthly quota
CG_KEYS=
# ── [recommended] Etherscan V2 key ───────────────────────────────────
# etherscan.io/apis — free; full-rate ETH scanning (works across chains)
ETHSCAN_KEY=
# ── [recommended] CryptoPanic token ──────────────────────────────────
# cryptopanic.com/developers/api — curated crypto news + votes
NEWS_TOKEN=
# ── [optional] extra data sources ────────────────────────────────────
# CryptoCompare free key (adds a 6th price source)
CRYPTOCOMPARE_KEY=
# ── AI providers (analyst LLM chain) ─────────────────────────────────
# Groq (groq.com, free) and/or Gemini (aistudio.google.com, free)
GROQ_KEY=
GEMINI_KEY=
# ── GitHub (workflows: daily report, monitor, trade loop) ───────────
# Repository secrets, not .env: WS_BOT_TOKEN, ADMIN_CHAT_ID, GEMINI_KEY,
# HL_TESTNET_KEY, GH_PAT (repo dispatch), GH_REPO
